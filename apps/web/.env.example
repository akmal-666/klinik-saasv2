# Env vars untuk Next.js dev server
# File ini di-generate otomatis oleh setup.sh dari root .env.local
# Jangan edit langsung — edit root .env.local lalu jalankan setup.sh

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=FILL_FROM_ROOT_ENV
NEXT_PUBLIC_SUPABASE_ANON_KEY=FILL_FROM_ROOT_ENV
NEXTAUTH_SECRET=FILL_FROM_ROOT_ENV
