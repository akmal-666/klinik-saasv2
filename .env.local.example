# ─── Klinik SaaS — Local Development (.env.local) ────────
# Copy file ini ke root project: klinik-saas/.env.local
# JANGAN commit file ini ke git

# ─── Supabase ─────────────────────────────────────────────
# Isi dari: https://app.supabase.com → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Database direct connection (untuk migration runner)
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── JWT ──────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_KEY_HERE_USE_OPENSSL
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Backend ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Next.js ──────────────────────────────────────────────
NEXTAUTH_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ─── Redis (opsional untuk dev, queue jalan mock) ─────────
# Daftar gratis: https://upstash.com
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ─── WhatsApp (opsional) ──────────────────────────────────
# WHATSAPP_API_URL=https://api.fonnte.com
# WHATSAPP_API_KEY=your_wa_key

# ─── SATUSEHAT (opsional) ────────────────────────────────
# SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id
# SATUSEHAT_CLIENT_ID=your_client_id
# SATUSEHAT_CLIENT_SECRET=your_secret
